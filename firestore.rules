rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Inquiries / Leads: Anyone can submit a lead form, only authenticated admin can read or write
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }
    
    // Portfolio Projects: Anyone can read, only authenticated admin can write
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Partner Brands: Anyone can read, only authenticated admin can write
    match /brands/{brandId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Client financial ledger: Only authenticated admin can read/write
    match /client_financials/{ledgerId} {
      allow read, write: if request.auth != null;
    }
    
    // Expenses tracker: Only authenticated admin can read/write
    match /expenses/{expenseId} {
      allow read, write: if request.auth != null;
    }
  }
}
